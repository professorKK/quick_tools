.venv/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Claude Code 本地设置（含本机权限配置，每台机器不同）
.claude/settings.local.json

# 打包相关（dist/ 按平台分目录：dist/win、dist/linux；中间文件在 build/ 下）
*.egg-info/
build/
dist/
*.whl
*.tar.gz
*.zip

# pip 构建隔离中断后可能残留在工作目录的临时目录
pip-build-env-*/
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/

# 可执行文件
*.spec
!QuickTools.spec
!QuickTools-onefile.spec
*.exe
